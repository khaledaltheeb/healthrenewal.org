name = "pterminology-specialists"
main = "src/index-v2.js"
compatibility_date = "2026-07-01"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://healthrenewal.org"
OWNER_EMAIL = "pterminology@gmail.com"
PORTAL_BASE_URL = "https://healthrenewal.org/specialists-partners/portal/"
TURNSTILE_EXPECTED_HOSTNAMES = "healthrenewal.org"
FROM_EMAIL = "منصة المختصين <notifications@your-verified-domain.example>"
ADMIN_SESSION_MINUTES = "20"

[secrets]
required = [
  "RESEND_API_KEY",
  "TURNSTILE_SECRET",
  "ADMIN_API_KEY",
  "RATE_LIMIT_SALT"
]

[[d1_databases]]
binding = "DB"
database_name = "pterminology-specialists"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[triggers]
crons = ["17 2 * * *"]

# Public values belong in [vars]. Private values must be supplied as Worker secrets.
