orCloseness:stage+1};
 }
 if(mode==='semantic_fluency'){
  const entry=pick(categories),size=[3,3,4,5,6][stage],correct=shuffle(entry[2],rnd).slice(0,size).join('، '),related=categories.filter(x=>x!==entry&&x[1]===entry[1]),unrelated=categories.filter(x=>x!==entry&&x[1]!==entry[1]),source=stage<2?unrelated:[...related,...unrelated],wrong=shuffle(source,rnd).slice(0,3).map((x,i)=>{const words=shuffle(x[2],rnd).slice(0,Math.max(1,size-1));words.push(entry[2][i%entry[2].length]);return shuffle(words,rnd).join('، ')}),frame=pick(['فحص الفئة','تمييز المجموعة','الطلاقة الدلالية','المجموعة المتجانسة']);
  return{...base,prompt:`${frame}: أي مجموعة تتكون جميع كلماتها من فئة «${entry[0]}»؟`,answer:correct,options:[correct,...wrong],explanation:`كل كلمات المجموعة الصحيحة تنتمي إلى ${entry[0]}.`,semanticSetSize:size,semanticDistractorCloseness:stage+1};
 }
 if(mode==='social_scenarios'){
  const tiers=[
   [['رفض مشاركة معلومة شخصية.','احترام الرفض وتغيير الموضوع'],['قال إنه لا يريد الحديث الآن.','عرض الدعم وترك مساحة'],['قوطع قبل إكمال فكرته.','إتاحة الفرصة له لإكمال كلامه'],['لم يفهم تعليمات قصيرة.','إعادة الشرح بهدوء وسؤال ما يحتاج توضيحًا'],['أخطأ أمام المجموعة.','تصحيح هادئ يحفظ الكرامة'],['انضم جديدًا وبقي صامتًا.','دعوتُه للمشاركة دون ضغط']],
   [['بدا منزعجًا لكنه لم يطلب نصيحة.','عرض الاستماع قبل تقديم الحلول'],['احتاج وقتًا أطول للإجابة.','منحه وقتًا كافيًا دون إكمال كلامه'],['طلب طريقة تواصل بديلة.','استخدام البديل المتاح واحترام اختياره'],['تعذر عليه حضور نشاط مزدحم.','عرض خيار أقل ازدحامًا دون إحراج'],['كرر سؤالًا لأنه لم يفهم.','تبسيط الإجابة والتحقق من الفهم'],['اعتذر عن خطأ أثر في غيره.','قبول الاعتذار ومناقشة إصلاح الضرر']],
   [['بدا عليه حمل حسي من الضوضاء.','تقليل المثيرات وسؤاله عن الدعم المناسب'],['تعذر عليه المشاركة بالطريقة المعتادة.','عرض بديل متاح دون افتراض العجز'],['شارك معلومة خاصة بثقة.','حفظ الخصوصية ما لم يوجد خطر على السلامة'],['اختلف مع شخص على قرار مشترك.','تلخيص الاحتياجات والبحث عن نقطة اتفاق'],['احتاج مساعدة لكنه رفض اللمس.','عرض المساعدة اللفظية واحترام حدوده الجسدية'],['أظهر توترًا في انتقال مفاجئ.','شرح الخطوة التالية ومنحه وقتًا للتكيف']],
   [['قالت مزحة تقلل من شخص أمام الآخرين.','وضع حد محترم ورفض التقليل مع دعم المتضرر'],['ظهر خلاف بين الخصوصية ومؤشر خطر.','شرح حدود الخصوصية وطلب دعم مختص بالسلامة'],['رفض قرارًا جماعيًا لأسباب لم تُفهم.','استكشاف الاحتياجات قبل الضغط على الموافقة'],['تعارضت رغبة الشخص مع طلب أسرته.','سماع الشخص والأسرة وتحديد الحقوق والمخاطر'],['أُسيء فهم تواصل غير لفظي.','التحقق من المعنى بدل الافتراض'],['أعطى موافقة ثم بدا غير مرتاح.','التوقف والتحقق من استمرار الموافقة']],
   [['طلب سرية معلومة تتضمن خطرًا مباشرًا.','توضيح ضرورة إشراك جهة حماية مناسبة بأقل كشف ممكن'],['تعارض استقلال الشخص مع خطر قابل للتقليل.','دعم القرار مع تقليل الخطر وتوثيق التفضيلات'],['أراد الفريق حلًا سريعًا دون سماع الشخص.','إيقاف القرار وإدخال صوته وخياراته المتاحة'],['اختلفت تفسيرات عدة لسلوك واحد.','جمع السياق والوظيفة المحتملة قبل الحكم'],['حدث ضرر رغم نية المساعدة.','الاعتراف بالأثر وإصلاحه وتعديل الإجراء'],['تكررت مشكلة حدود داخل فريق.','وضع اتفاق واضح للموافقة والخصوصية والمراجعة']]
  ],s=pick(tiers[stage]),name=pick(names),plausible=stage<3?['الإلحاح حتى يقبل','التجاهل دون توضيح','اتخاذ القرار عنه']:['تقديم حل سريع دون تحقق','الانتظار دون حماية أو توضيح','افتراض النية بدل سؤال الشخص'];
  return{...base,prompt:`${name} ${s[0]} ما الاستجابة الأنسب؟`,answer:s[1],options:[s[1],...plausible],explanation:'تزداد المواقف من حدود واضحة إلى موازنة الموافقة والخصوصية والسلامة والاستقلال.',socialNuance:stage+1};
 }
 if(mode==='verbal_analogy'){
  const pools=[
   [['طبيب','مستشفى'],['معلم','مدرسة'],['قاضٍ','محكمة'],['صيدلي','صيدلية'],['خباز','مخبز'],['طيار','مطار'],['ربان','سفينة'],['مزارع','حقل'],['أمين مكتبة','مكتبة'],['ممثل','مسرح']],
   [['قلم','كتابة'],['فرشاة','رسم'],['مقص','قص'],['مكنسة','تنظيف'],['مفتاح','فتح'],['ميزان','وزن'],['ساعة','وقت'],['بوصلة','اتجاه'],['عدسة','تكبير'],['مقياس حرارة','درجة الحرارة']],
   [['يد','إصبع'],['شجرة','غصن'],['كتاب','صفحة'],['منزل','غرفة'],['سيارة','عجلة'],['جسم','قلب'],['قميص','كم'],['سلسلة','حلقة'],['حاسوب','لوحة مفاتيح'],['زهرة','بتلة']],
   [['مطر','بلل'],['نار','حرارة'],['تدريب','تحسن'],['جوع','بحث عن طعام'],['سؤال','بحث عن إجابة'],['احتكاك','حرارة'],['ضغط','انضغاط'],['تعرض للشمس','دفء'],['تكرار','إتقان'],['تأخير','انتظار']],
   [['دقيقة','ساعة'],['حرف','كلمة'],['كلمة','جملة'],['خطوة','مسار'],['بذرة','نبات'],['فكرة','خطة'],['ملاحظة','استنتاج'],['بيانات','قرار'],['سؤال','فرضية'],['مشكلة','حل']]
  ],pool=pools[stage],first=pick(pool),second=pick(pool.filter(x=>x!==first)),answer=second[1],wrong=shuffle(pools.flat().map(x=>x[1]).filter(x=>x!==answer),rnd).slice(0,3);
  return{...base,prompt:`${first[0]} بالنسبة إلى ${first[1]} مثل ${second[0]} بالنسبة إلى ماذا؟`,answer,options:[answer,...wrong],explanation:`العلاقة في المستوى الحالي تقود إلى ${answer}.`,analogyTier:stage+1};
 }
