لسبب';options=[answer,s[0],`لم يحدث: ${s[0]}`,'النتيجة تثبت السبب'];explanation='حدوث النتيجة لا يثبت سببًا واحدًا.';type='affirming-consequent-trap'}
  else if(stage===3){statement=`ولم يحدث: ${s[0]}`;answer='لا يمكن الجزم بالنتيجة';options=[answer,s[1],`لم يحدث: ${s[1]}`,'نفي الشرط ينفي النتيجة'];explanation='نفي الشرط لا يثبت نفي النتيجة.';type='denying-antecedent-trap'}
  else{statement=`وقد ${s[1]}. معلومة إضافية: إذا ${extra[0]} فإن ${extra[1]}`;answer='لا يمكن الجزم بالسبب';options=[answer,s[0],extra[0],'كلا السببين مؤكد'];explanation='وجود نتيجة ومقدمة إضافية لا يحدد السبب دون دليل كافٍ.';type='multi-premise-distractor'}
  return{...base,prompt:`${frame}: إذا ${s[0]} فإن ${s[1]}. ${statement}. ما الاستنتاج اللازم؟`,answer,options,explanation,inferenceComplexity:stage+1,inferenceType:type};
 }
