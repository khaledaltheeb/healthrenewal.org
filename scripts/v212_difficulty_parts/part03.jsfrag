لامة','أخذ دواء في موعده','استلام طفل في موعده'],important=['إعداد ملف مقابلة الغد','مراجعة تقرير قرار مهم','التحضير لموعد طبي','إكمال طلب تنتهي مهلته اليوم'];let tasks,answer,explanation;
  if(stage===0){answer=pick(urgent);tasks=shuffle([answer,...shuffle(routine,rnd).slice(0,3)],rnd);explanation='تتقدم السلامة والموعد الفوري.'}
  else if(stage===1){answer=`إرسال ملف خلال ${pick(['20','30','40'])} دقيقة`;tasks=shuffle([answer,`تسليم آخر غدًا`,...shuffle(routine,rnd).slice(0,2)],rnd);explanation='يتقدم الموعد الأقرب عندما تتقارب الآثار.'}
  else if(stage===2){const goal=pick(important);answer=`إنهاء المتطلب الذي يعتمد عليه: ${goal}`;tasks=shuffle([answer,goal,...shuffle(routine,rnd).slice(0,2)],rnd);explanation='تتقدم المهمة السابقة التي تتوقف عليها مهمة أخرى.'}
  else if(stage===3){answer=pick(important);tasks=shuffle([answer,`رد عاجل منخفض الأثر`,...shuffle(routine,rnd).slice(0,2)],rnd);explanation='لا تعني العجلة وحدها أولوية أعلى من الأثر والموعد.'}
  else{answer=pick(urgent);tasks=shuffle([answer,pick(important),`مهمة عاجلة قابلة للتفويض`,pick(routine)],rnd);explanation='تُوازن السلامة والمهلة وعدم قابلية العكس وإمكان التفويض.'}
  return{...base,prompt:`أي مهمة تبدأ بها أولًا؟ ${tasks.join('، ')}`,answer,options:tasks,explanation,priorityDemand:stage+1};
 }
