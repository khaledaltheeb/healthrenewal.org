  ],s=cases[stage];return{...base,prompt:s[0],answer:s[1],options:s[2],explanation:'يتدرج حل المشكلة من التعريف إلى البيانات والمقارنة والاختبار والتحليل الجذري.',problemPhase:stage+1};
