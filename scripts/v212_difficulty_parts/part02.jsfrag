  return{...base,prompt,answer,options:shuffle(options,rnd),explanation:`الإجابة تعتمد على المعلومات المتاحة للشخص المقصود، لا على الموقع الحقيقي فقط.`,perspectiveOrder:order,narrativeMoves:moves};
