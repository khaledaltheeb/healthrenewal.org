  return{...base,prompt:`${name} ${cue}. ما الانفعال الأكثر اتساقًا مع القرائن؟`,answer:group[0],options:[group[0],...wrong],explanation:`القرائن تتوافق أكثر مع ${group[0]}.`,emotionTier:stage+1};
 }
