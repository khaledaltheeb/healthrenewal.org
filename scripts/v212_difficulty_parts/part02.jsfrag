  else if(stage===1){prompt=`وضع ${person} ${object} في ${original} ثم خرج. رأى ${witness} ${mover} ينقله إلى ${first}. أين سيبحث ${person} أولًا؟`;answer=original;options=[original,first,second,'حيث يظن الشاهد'];order=1;moves=1}
