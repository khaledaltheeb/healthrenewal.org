
function v212DifficultyData(d,stage,index,sessionSeed,rnd,ri,pick,symbols,arrows){
 const mode=d.mode||d.category||'', colors=[['أحمر','#b42318'],['أزرق','#175cd3'],['أخضر','#067647'],['برتقالي','#b54708'],['بنفسجي','#6941c6'],['تركواز','#087e8b']], positions=['الوسط','اليمين','اليسار','الأعلى','الأسفل'];
