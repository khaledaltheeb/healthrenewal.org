 }
 if(mode==='response_inhibition'){
  const shownSymbol=pick(symbols),shownColor=pick(colors),target=pick(symbols),second=pick(symbols.filter(x=>x!==target)),targetColor=pick(colors),cue=pick(['أ','ب']);let answer,prompt,explanation,ruleClauses;
  if(stage===0){answer=shownSymbol===target?'استجب':'امتنع';prompt=`استجب فقط عند ${target}. ظهر ${shownSymbol}.`;explanation=shownSymbol===target?'ظهر الهدف.':'ظهر مشتت.';ruleClauses=1}
