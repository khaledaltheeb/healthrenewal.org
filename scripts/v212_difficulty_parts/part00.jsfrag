 const base={difficultyLoad:stage+1,difficultyDescriptor:`المستوى ${stage+1} من خمسة`};
 if(mode==='choice_reaction'||mode==='visual_reaction'){
  const symbol=pick(symbols),color=pick(colors),position=pick(positions),domains=stage<3?[[['symbol']],[['color']],[['position']]][stage][0]:stage===3?['symbol','color']:['symbol','color','position'],domain=pick(domains);
  const answer=domain==='symbol'?symbol:domain==='color'?color[0]:position,all=[...symbols,...colors.map(x=>x[0]),...positions],choiceCount=[4,5,5,6,7][stage],opts=optionsFor(answer,stage<3?(domain==='symbol'?symbols:domain==='color'?colors.map(x=>x[0]):positions):all,choiceCount);
