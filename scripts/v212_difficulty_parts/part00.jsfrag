  else if(stage===3){const go=shownSymbol===target&&shownColor[0]===targetColor[0];answer=go?'استجب':'امتنع';prompt=`استجب فقط إذا اجتمع الرمز ${target} واللون ${targetColor[0]}. ظهر <span style="color:${shownColor[1]};font-size:2em;font-weight:900">${shownSymbol}</span>.`;explanation=go?'تحقق الشرطان معًا.':'لم يتحقق الشرطان معًا.';ruleClauses=3}
  else{const useSymbol=cue==='أ',go=useSymbol?shownSymbol===target:shownColor[0]===targetColor[0];answer=go?'استجب':'امتنع';prompt=`الإشارة ${cue}: عند «أ» طبّق قاعدة الرمز ${target}، وعند «ب» طبّق قاعدة اللون ${targetColor[0]}. ظهر <span style="color:${shownColor[1]};font-size:2em;font-weight:900">${shownSymbol}</span>.`;explanation=`طُبقت قاعدة ${useSymbol?'الرمز':'اللون'}؛ ${go?'تحقق الهدف':'لم يتحقق الهدف'}.`;ruleClauses=4}
  return{...base,prompt,answer,options:['استجب','امتنع'],explanation,inhibitionRuleComplexity:stage+1,ruleClauses};
 }
 if(mode==='conditional_reasoning'){
