  if(stage===0){statement=`وقد ${s[0]}`;answer=s[1];options=[answer,`لم يحدث: ${s[1]}`,'لا يمكن الجزم بالنتيجة','الشرط معكوس'];explanation='تحقق الشرط فتَلزم النتيجة.';type='modus-ponens'}
  else if(stage===1){statement=`ولم يحدث: ${s[1]}`;answer=`لم يحدث: ${s[0]}`;options=[answer,s[0],'لا يمكن الجزم بالسبب',s[1]];explanation='نفي النتيجة يسمح بنفي الشرط.';type='modus-tollens'}
