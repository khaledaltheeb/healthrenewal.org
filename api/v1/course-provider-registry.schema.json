{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaledaltheeb.github.io/pterminology-site/api/v1/course-provider-registry.schema.json",
  "title": "Authorized Course Provider Registry",
  "description": "سجل مؤسسي لمزودي الدورات الذين يوجد إذن موثق لاستيراد بياناتهم الوصفية فقط.",
  "type": "object",
  "required": ["registryVersion", "updatedAt", "policy", "providers"],
  "properties": {
    "registryVersion": {"type": "string", "const": "1.0"},
    "updatedAt": {"type": "string", "format": "date"},
    "policy": {"type": "string", "const": "permission_required"},
    "providers": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "name", "website", "status", "authorization", "feed", "rights"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 160},
          "website": {"type": "string", "format": "uri"},
          "status": {"type": "string", "enum": ["authorized", "suspended", "revoked", "expired"]},
          "authorization": {
            "type": "object",
            "required": ["evidenceUrl", "license", "verifiedAt", "expiresAt"],
            "properties": {
              "evidenceUrl": {"type": "string", "format": "uri"},
              "license": {"type": "string", "minLength": 2, "maxLength": 200},
              "verifiedAt": {"type": "string", "format": "date"},
              "expiresAt": {"type": ["string", "null"], "format": "date"}
            },
            "additionalProperties": false
          },
          "feed": {
            "type": "object",
            "required": ["url", "format", "allowedHosts", "maxBytes"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "format": {"type": "string", "const": "authorized-course-feed-v1"},
              "allowedHosts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}
              },
              "maxBytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
              "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          "rights": {
            "type": "object",
            "required": ["metadataReuse", "contentReuse", "attributionRequired"],
            "properties": {
              "metadataReuse": {"type": "boolean", "const": true},
              "contentReuse": {"type": "boolean", "const": false},
              "attributionRequired": {"type": "boolean"},
              "attributionText": {"type": "string", "maxLength": 500}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
