{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthrenewal.org/schemas/publishing/translation-record.schema.json",
  "title": "Rawafid Translation Record",
  "type": "object",
  "required": ["schema_version", "id", "source_work", "target", "rights", "contributors", "review", "workflow"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,120}$"},
    "source_work": {
      "type": "object",
      "required": ["title", "publisher", "landing_page", "language"],
      "properties": {
        "title": {"type": "string", "minLength": 2},
        "publisher": {"type": "string", "minLength": 2},
        "landing_page": {"type": "string", "format": "uri"},
        "doi": {"type": ["string", "null"]},
        "isbn": {"type": ["string", "null"]},
        "language": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["language", "working_title", "publication_role"],
      "properties": {
        "language": {"const": "ar"},
        "working_title": {"type": "string", "minLength": 2},
        "publication_role": {"enum": ["rawafid-authorized-translation-publisher", "publisher-directed-translation", "translation-only"]}
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": ["rights_record_id", "translation_allowed", "basis"],
      "properties": {
        "rights_record_id": {"type": "string", "minLength": 3},
        "translation_allowed": {"type": "boolean"},
        "basis": {"enum": ["open-license-allows-adaptation", "written-permission", "contract"]},
        "source_license_url": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "role": {"enum": ["translator", "translation-editor", "subject-reviewer", "language-reviewer", "accessibility-reviewer"]},
          "orcid": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["terminology", "subject", "language", "rights", "accessibility"],
      "properties": {
        "terminology": {"enum": ["pending", "passed", "failed"]},
        "subject": {"enum": ["pending", "passed", "failed", "not-applicable"]},
        "language": {"enum": ["pending", "passed", "failed"]},
        "rights": {"enum": ["pending", "passed", "failed"]},
        "accessibility": {"enum": ["pending", "passed", "failed"]}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["status", "updated_at"],
      "properties": {
        "status": {"enum": ["candidate", "rights-review", "authorized", "translation", "review", "metadata", "ready-to-publish", "published", "withdrawn"]},
        "updated_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
