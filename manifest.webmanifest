{
  "id": "/",
  "name": "منصة الصحة النفسية وذوي الاحتياجات الخاصة",
  "short_name": "HealthRenewal",
  "description": "موسوعة عربية للصحة النفسية والأشخاص ذوي الاحتياجات الخاصة والأدلة العملية والتربية الدامجة.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#075f5b",
  "categories": [
    "education",
    "health",
    "medical"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
